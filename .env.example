# Environment Configuration
# Copy this file to .env and fill in your values

# Access code for the private room (the "Movie No.")
ROOM_ACCESS_CODE=123456

# Telegram Bot API (optional — app works without these)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Server port
PORT=3000

# Optional: public URL of the deployed frontend (used for CORS or client configuration)
# Example: https://your-app.onrender.com
FRONTEND_URL=
